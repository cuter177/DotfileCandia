{
    "layer": "top",
    "position": "top",
    "width": "100%",
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,

    "modules-left": ["custom/launcher", "group/left"],
    "modules-center": ["group/center"],
    "modules-right": ["group/right"],

    "group/left": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "custom/mic", "custom/bluetooth", "group/workspaces", "custom/cava"]
    },
    "group/center": {
        "orientation": "horizontal",
        "modules": ["custom/media"]
    },
    "group/right": {
        "orientation": "horizontal",
        "modules": ["backlight", "network", "pulseaudio", "custom/language", "battery", "clock", "custom/power"]
    },

    "pulseaudio": {
        "tooltip": false,
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-muted": "{icon} {volume}%",
        "on-click": "~/.config/waybar/scripts/pavucontrol-popup.sh",
        "format-icons": {
            "default": ["", "", ""]
        }
    },
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6"]
    },
    "custom/ws1": {
        "exec": "~/.config/waybar/scripts/workspace-button.py 1",
        "return-type": "json",
        "restart-interval": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
    },
    "custom/ws2": {
        "exec": "~/.config/waybar/scripts/workspace-button.py 2",
        "return-type": "json",
        "restart-interval": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
    },
    "custom/ws3": {
        "exec": "~/.config/waybar/scripts/workspace-button.py 3",
        "return-type": "json",
        "restart-interval": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"
    },
    "custom/ws4": {
        "exec": "~/.config/waybar/scripts/workspace-button.py 4",
        "return-type": "json",
        "restart-interval": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"
    },
    "custom/ws5": {
        "exec": "~/.config/waybar/scripts/workspace-button.py 5",
        "return-type": "json",
        "restart-interval": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"
    },
    "custom/ws6": {
        "exec": "~/.config/waybar/scripts/workspace-button.py 6",
        "return-type": "json",
        "restart-interval": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'"
    },
    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "󰈁",
        "format-disconnected": "",
        "tooltip": true,
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
    },

    "backlight": {
        "tooltip": false,
        "format": "󰖨 {}%",
        "interval": 1,
        "on-scroll-up": "light -A 5",
        "on-scroll-down": "light -U 5",
        "on-click": "~/.config/waybar/scripts/brightness-popup.sh"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    "clock": {
        "tooltip": true,
        "interval": 60,
        "format": "{:%H:%M}",
        "tooltip-format": "{:%Y-%m-%d}",
        "on-click": "~/.config/waybar/scripts/calendario.sh"
    },

    "group/system-info": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "disk"],
        "on-hover": "expand"
    },

    "cpu": {
        "interval": 15,
        "format": " {}%",
        "max-length": 10,
        "id": "system-info-cpu"
    },

    "memory": {
        "interval": 30,
        "format": " {used}GB",
        "max-length": 10,
        "id": "system-info-memory"
    },

    "disk": {
        "format": " {used}",
        "interval": 1,
        "id": "system-info-disk"
    },

    "custom/media": {
        "interval": 5,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/spotify-media.sh",
        "max-length": 40,
        "on-click": "~/.config/waybar/scripts/goto-spotify.sh",
        "on-click-right": "~/.config/waybar/scripts/media-control.sh play-pause",
        "on-click-middle": "~/.config/waybar/scripts/media-control.sh next"
    },

    "custom/launcher": {
        "format": " ",
        "on-click": "rofi -show drun",
        "on-click-right": "killall rofi"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout"
    },
    "custom/updates": {
        "format": "{} Update(s)",
        "exec": "checkupdates | wc -l",
        "exec-if": "[[ $(checkupdates | wc -l) != 0 ]]",
        "interval": 15,
        "on-click": "alacritty -e paru -Syu && notify-send 'The system has been updated' "
    },
    "custom/bluetooth": {
        "exec": "~/.config/waybar/scripts/bluetooth-status.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "blueman-manager"
    },
    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava.sh",
        "return-type": "raw",
        "tooltip": false,
        "restart-interval": 1
    },
    "custom/language": {
        "exec": "~/.config/waybar/scripts/keyboard-layout.sh",
        "interval": 1,
        "tooltip": false,
        "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next"
    },
    "custom/mic": {
        "exec": "~/.config/waybar/scripts/mic-status.sh",
        "interval": "once",
        "signal": 2,
        "return-type": "json",
        "tooltip": false,
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle && pkill -RTMIN+2 waybar"
    }
}
